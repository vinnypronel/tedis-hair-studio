\",\"h3\",null,{\"className\":\"font-display text-lg font-medium tracking-tight text-stone-900\",\"children\":\"Third-party services\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-relaxed text-stone-600\",\"children\":\"The contact page embeds Google Maps. Loading that map sends connection information to Google. Links to Booksy and Instagram open services with their own privacy policies. Website hosting providers may process technical request information to deliver and secure this website.\"}]]}],[\"$\",\"section\",\"Privacy requests\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-display text-lg font-medium tracking-tight text-stone-900\",\"children\":\"Privacy requests\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-relaxed text-stone-600\",\"children\":\"Contact the studio with questions about information you have shared directly. Requests about information held by Booksy or another service may also need to be made to that provider.\"}]]}],[\"$\",\"section\",\"Questions\",{\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-display text-lg font-medium tracking-tight text-stone-900\",\"children\":\"Questions\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-relaxed text-stone-600\",\"children\":\"This is a one-person studio, so privacy questions go straight to the person responsible: (732) 947-7359 or tedishairstudio@gmail.com.\"}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"space-y-12 md:pl-12 lg:pl-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"border-b border-stone-200 pb-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold tracking-tight text-forest-deep\",\"children\":\"Terms of Service\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-stone-500\",\"children\":\"Our studio rules.\"}]]}],[\"$\",\"div\",null,{\"className\":\"space-y-10\",\"children\":[[\"$\",\"section\",\"Appointments\",{\"children\":[\"$L13\",\"$L14\"]}],\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"