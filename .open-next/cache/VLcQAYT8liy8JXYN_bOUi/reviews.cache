,\\\"featured\\\":true,\\\"published\\\":true,\\\"sortOrder\\\":30},{\\\"id\\\":\\\"rev-9590064\\\",\\\"authorName\\\":\\\"Zach P.\\\",\\\"rating\\\":5,\\\"text\\\":\\\"Welcoming atmosphere! Tedi is hands down the Best barber in NJ! Check out Tedi Hair Studios\\\",\\\"source\\\":\\\"booksy\\\",\\\"sourceDate\\\":\\\"2025-10-13\\\",\\\"featured\\\":false,\\\"published\\\":true,\\\"sortOrder\\\":74},{\\\"id\\\":\\\"rev-10156820\\\",\\\"authorName\\\":\\\"Tyler M.\\\",\\\"rating\\\":5,\\\"text\\\":\\\"Best place to get a cut always leave feeling better than you walked in Matt’s the best\\\",\\\"source\\\":\\\"booksy\\\",\\\"sourceDate\\\":\\\"2026-02-07\\\",\\\"featured\\\":false,\\\"published\\\":true,\\\"sortOrder\\\":57},{\\\"id\\\":\\\"rev-9184775\\\",\\\"authorName\\\":\\\"Julie B.\\\",\\\"rating\\\":5,\\\"text\\\":\\\"did a great job on both if my boys. First time using him will definitely be back again\\\",\\\"source\\\":\\\"booksy\\\",\\\"sourceDate\\\":\\\"2025-08-04\\\",\\\"featured\\\":false,\\\"published\\\":true,\\\"sortOrder\\\":92},{\\\"id\\\":\\\"rev-9756106\\\",\\\"authorName\\\":\\\"Fabio C.\\\",\\\"rating\\\":5,\\\"text\\\":\\\"Tedi’s super chill and always gets my cut looking clean. Definitely my go-to barber.\\\",\\\"source\\\":\\\"booksy\\\",\\\"sourceDate\\\":\\\"2025-11-15\\\",\\\"featured\\\":false,\\\"published\\\":true,\\\"sortOrder\\\":68},{\\\"id\\\":\\\"rev-8661345\\\",\\\"authorName\\\":\\\"RICHARD D.\\\",\\\"rating\\\":5,\\\"text\\\":\\\"You always do excellent. I see excellent in you you ex zoom excellence glory to God.\\\",\\\"source\\\":\\\"booksy\\\",\\\"sourceDate\\\":\\\"2025-04-14\\\",\\\"featured\\\":false,\\\"published\\\":true,\\\"sortOrder\\\":124},{\\\"id\\\":\\\"rev-8049901\\\",\\\"authorName\\\":\\\"Oleg B.\\\",\\\"rating\\\":5,\\\"text\\\":\\\"The best barber in the area! Tedi does a great job with any cuts, highly recommend!!\\\",\\\"source\\\":\\\"booksy\\\",\\\"sourceDate\\\":\\\"2024-11-08\\\",\\\"featured\\\":false,\\