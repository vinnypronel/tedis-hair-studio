ne-flex;\n          align-items: center;\n          justify-content: center;\n          gap: 12px;\n          padding: 4px 16px;\n          font-family: var(--font-display);\n          font-size: clamp(1.85rem, 8.5vw, 2.8rem);\n          font-weight: 400;\n          line-height: 1.15;\n          letter-spacing: -0.02em;\n          color: #faf6ee;\n          text-decoration: none;\n          opacity: 0;\n          transform: translateY(18px);\n          transition: color 0.25s ease, opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);\n        }\n\n        .nav-takeover-panel.open .nav-takeover-link {\n          opacity: 1;\n          transform: none;\n        }\n\n        /* Staggered Delay */\n        .nav-takeover-panel.open li:nth-child(1) .nav-takeover-link { transition-delay: 0.08s; }\n        .nav-takeover-panel.open li:nth-child(2) .nav-takeover-link { transition-delay: 0.13s; }\n        .nav-takeover-panel.open li:nth-child(3) .nav-takeover-link { transition-delay: 0.18s; }\n        .nav-takeover-panel.open li:nth-child(4) .nav-takeover-link { transition-delay: 0.23s; }\n        .nav-takeover-panel.open li:nth-child(5) .nav-takeover-link { transition-delay: 0.28s; }\n        .nav-takeover-panel.open li:nth-child(6) .nav-takeover-link { transition-delay: 0.33s; }\n\n        .nav-takeover-link:hover,\n        .nav-takeover-link.active {\n          color: #f5c518;\n        }\n\n        .nav-takeover-link.active {\n          text-decoration: underline;\n          text-decoration-thickness: 2px;\n          text-underline-offset: 8px;\n        }\n\n        /* CTA Reveal */\n        .nav-takeover-cta {\n          opacity: 0;\n          transform: translateY(18px);\n          transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);\n        }\n        .nav-takeover-panel.open .nav-takeover-cta {\n          opacity: 1;\n          transform: none;\n          transition-delay: 0.38s;\n        }\n\n        /* Footer Socials */\n        .nav-takeover-footer {\n          opacity: 0;\n          transition: opacity 0.4s ease 0.42s;\n        }\n        .nav-takeover-panel.open .nav-takeover-footer {\n          opacity: 1;\n        }\n\n        /* ── Landscape / Short-Screen Optimizations ── */\n        @media (max-height: 620px) {\n          .nav-takeover-panel {\n            padding: 76px 16px 14px !important;\n            gap: 12px !important;\n          }\n          .nav-takeover-links {\n            gap: 4px !important;\n          }\n          .nav-takeover-link {\n            font-size: clamp(1.2rem, 5vh, 1.65rem) !important;\n            padding: 4px 8px !important;\n          }\n        }\n\n        /* ── Reduced Motion ── */\n        @media (prefers-reduced-motion: reduce) {\n          .nav-takeover-panel,\n          .nav-takeover-link,\n          .nav-takeover-cta,\n          .nav-takeover-footer {\n            transition-duration: 0.001s !important;\n            transition-delay: 0s !important;\n          }\n        }\n      </style><header role=\"banner\" class=\"fixed inset-x-0 top-0 z-50 transition-colors duration-500 bg-bone/95 text-ink backdrop-blur-sm hairline-b\"><div class=\"mx-auto flex max-w-[1440px] items-center justify-between px-6 py-4 md:px-12 lg:px-20\"><a class=\"flex origin-left items-center gap-3 transition-transform duration-300 hover:scale-105\" aria-label=\"Tedi&#x27;s Hair Studio, home\" href=\"/\"><span role=\"img\" aria-label=\"Tedi&#x27;s Hair Studio bear mark\" class=\"bear-mask shrink-0 bear-idle\" style=\"width:48px;height:48px\"></span><span class=\"font-display text-xl tracking-tight whitespace-nowrap\">Tedi’s Hair Studio</span></a><nav class=\"hidden items-center gap-5 lg:flex xl:gap-8\" aria-label=\"Main Navigation\"><a class=\"link-draw text-sm transition-colors\" href=\"/\">Home</a><a class=\"link-draw text-sm transition-colors\" href=\"/services\">Services</a><a aria-current=\"page\" class=\"link-draw text-sm transition-colors font-semibold link-active text-forest-deep\" href=\"/reviews\">Reviews</a><a class=\"link-draw text-sm transition-colors\" href=\"/gallery\">Gallery</a><a class=\"link-draw text-sm transition-colors\" href=\"/about\">About</a><a class=\"link-draw text-sm transition-colors\" href=\"/contact\">Contact</a><a class=\"link-draw text-sm transition-colors\" href=\"/shop\">Shirts</a><a href=\"https://booksy.com/en-us/instant-experiences/widget/1231797?instant_experiences_enabled=true\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-center gap-2.5 rounded-[2px] border border-transparent px-5 py-2.5 text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 hover:translate-x-0.5 bg-forest text-cream hover:border-forest hover:bg-cream hover:text-forest\">Book Now<span aria-hidden=\"true\" class=\"transition-transform duration-300 group-hover:translate-x-1\">→</span><span class=\"sr-only\"> (opens <!-- -->Booksy<!-- --> in a new tab)</span></a></nav><button type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"mobile-nav-takeover\" class=\"cursor-pointer flex h-10 w-10 items-center justify-center rounded p-2 text-current lg:hidden\"><span aria-hidden=\"true\" class=\"flex w-6 flex-col items-center justify-center gap-[5px]\"><span class=\"block h-[2px] w-6 rounded-full bg-current transition-all duration-300\"></span><span class=\"block h-[2px] w-6 rounded-full bg-current transition-all duration-300\"></span><span class=\"block h-[2px] w-6 rounded-full bg-current transition-all duration-300\"></span></span></button></div></header><div id=\"mobile-nav-takeover\" class=\"nav-takeover-panel\" aria-hidden=\"true\" inert=\"\" data-lenis-prevent=\"true\"><nav aria-label=\"Mobile Navigation\" class=\"w-full max-w-sm\"><ul class=\"nav-takeover-links flex flex-col items-center gap-2 list-none p-0 m-0\"><li><a tabindex=\"-1\" class=\"nav-takeover-link\" href=\"/\">Home</a></li><li><a tabindex=\"-1\" class=\"nav-takeover-link\" href=\"/services\">Services</a></li><li><a tabindex=\"-1\" aria-current=\"page\" class=\"nav-takeover-link active\" href=\"/reviews\">Reviews</a></li><li><a tabindex=\"-1\" class=\"nav-takeover-link\" href=\"/gallery\">Gallery</a></li><li><a tabindex=\"-1\" class=\"nav-takeover-link\" href=\"/about\">About</a></li><li><a tabindex=\"-1\" class=\"nav-takeover-link\" href=\"/contact\">Contact</a></li><li><a tabindex=\"-1\" class=\"nav-takeover-link\" href=\"/shop\">Shirts</a></li></ul><div class=\"nav-takeover-cta mt-9 flex justify-center\"><a href=\"https://booksy.com/en-us/instant-experiences/widget/1231797?instant_experiences_enabled=true\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-display inline-flex items-center gap-3 rounded-[2px] bg-cream px-8 py-3 text-xl tracking-tight text-forest-deep transition-transform duration-300 hover:scale-105\">Book Now<span aria-hidden=\"true\">→</span><span class=\"sr-only\"> (opens <!-- -->Booksy<!-- --> in a new tab)</span></a></div></nav><div class=\"nav-takeover-footer flex flex-wrap items-center justify-center gap-x-5 gap-y-2 pt-3 text-cream/70\"><a href=\"https://instagram.com/tedishairstudio\" target=\"_blank\" rel=\"noopener noreferrer\" tabindex=\"-1\" class=\"mono-micro text-[13px] transition-colors hover:text-neon\">Instagram ↗</a><span class=\"text-cream/30\">·</span><a href=\"tel:+17329477359\" tabindex=\"-1\" class=\"mono-micro text-[13px] transition-colors hover:text-neon\">(732) 947-7359</a></div></div><main id=\"main-content\" tabindex=\"-1\"><div style=\"opacity:0;transform:translateY(14px)\"><div class=\"pb-24 lg:pb-36\"><div class=\"px-6 pt-24 md:px-12 lg:px-20 lg:pt-28\"><div class=\"mx-auto max-w-[1440px]\"><div style=\"opacity:0;transform:translateY(20px)\"><div class=\"hairline-b grid gap-x-16 gap-y-12 pb-12 lg:grid-cols-12 lg:items-center lg:pb-14\"><div class=\"lg:col-span-5\"><h1 class=\"display-lg\"><em class=\"italic\">Five stars, only.</em></h1><div class=\"mt-8 flex items-end gap-6\"><span class=\"font-display text-7xl leading-[0.85] tracking-tight\">5.0</span><span class=\"pb-1 font-mono text-lg tracking-[0.3em] text-[#d4af37]\">★★★★★</span></div><p class=\"mono-micro mt-5 text-stone-500\">Based on <!-- -->168<!-- --> reviews ·<!-- --> <a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"link-draw text-stone-700\">via <!-- -->Booksy<!-- --> ↗</a></p><p class=\"mono-micro mt-5 text-stone-500\">Last updated 10/27/26<span aria-hidden=\"true\" class=\"caret-blink ml-1 inline-block h-[1em] w-[2px] translate-y-[2px] bg-stone-500 align-middle\"></span></p></div><div class=\"lg:col-span-7\"><div class=\"flex flex-col gap-3.5\"><div class=\"flex items-center gap-5\"><span class=\"mono-micro flex w-9 shrink-0 items-center gap-1 tabular-nums text-ink\">5<span aria-hidden=\"true\" class=\"text-forest\">★</span></span><span class=\"sr-only\">5 star: 168 of 168 reviews</span><div aria-hidden=\"true\" class=\"relative h-[7px] flex-1 bg-ink/[0.08]\"><div class=\"absolute inset-y-0 left-0 bg-forest\" style=\"width:0px\"></div></div><span aria-hidden=\"true\" class=\"mono-micro w-10 shrink-0 text-right tabular-nums text-ink\">168</span></div><div class=\"flex items-center gap-5\"><span class=\"mono-micro flex w-9 shrink-0 items-center gap-1 tabular-nums text-stone-500\">4<span aria-hidden=\"true\" class=\"text-stone-300\">★</span></span><span class=\"sr-only\">4 star: 0 of 168 reviews</span><div aria-hidden=\"true\" class=\"relative h-[7px] flex-1 bg-ink/[0.08]\"><div class=\"absolute inset-y-0 left-0 bg-forest\" style=\"width:0px\"></div></div><span aria-hidden=\"true\" class=\"mono-micro w-10 shrink-0 text-right tabular-nums text-stone-500\">0</span></div><div class=\"flex items-center gap-5\"><span class=\"mono-micro flex w-9 shrink-0 items-center gap-1 tabular-nums text-stone-500\">3<span aria-hidden=\"true\" class=\"text-stone-300\">★</span></span><span class=\"sr-only\">3 star: 0 of 168 reviews</span><div aria-hidden=\"true\" class=\"relative h-[7px] flex-1 bg-ink/[0.08]\"><div class=\"absolute inset-y-0 left-0 bg-forest\" style=\"width:0px\"></div></div><span aria-hidden=\"true\" class=\"mono-micro w-10 shrink-0 text-right tabular-nums text-stone-500\">0</span></div><div class=\"flex items-center gap-5\"><span class=\"mono-micro flex w-9 shrink-0 items-center gap-1 tabular-nums text-stone-500\">2<span aria-hidden=\"true\" class=\"text-stone-300\">★</span></span><span class=\"sr-only\">2 star: 0 of 168 reviews</span><div aria-hidden=\"true\" class=\"relative h-[7px] flex-1 bg-ink/[0.08]\"><div class=\"absolute inset-y-0 left-0 bg-forest\" style=\"width:0px\"></div></div><span aria-hidden=\"true\" class=\"mono-micro w-10 shrink-0 text-right tabular-nums text-stone-500\">0</span></div><div class=\"flex items-center gap-5\"><span class=\"mono-micro flex w-9 shrink-0 items-center gap-1 tabular-nums text-stone-500\">1<span aria-hidden=\"true\" class=\"text-stone-300\">★</span></span><span class=\"sr-only\">1 star: 0 of 168 reviews</span><div aria-hidden=\"true\" class=\"relative h-[7px] flex-1 bg-ink/[0.08]\"><div class=\"absolute inset-y-0 left-0 bg-forest\" style=\"width:0px\"></div></div><span aria-hidden=\"true\" class=\"mono-micro w-10 shrink-0 text-right tabular-nums text-stone-500\">0</span></div></div><div class=\"mt-6 flex items-center justify-between gap-4\"><p class=\"mono-micro text-stone-500\">168<!-- --> of <!-- -->168<!-- --> are five stars. Nothing below.</p><span class=\"font-mono text-base tracking-[0.25em] text-forest\" aria-label=\"5 stars\">★★★★★</span></div></div></div></div><div id=\"review-list\" class=\"scroll-mt-28\"><div class=\"mt-10 flex justify-end\"><p class=\"mono-micro text-stone-500\">Page <!-- -->1<!-- -->/<!-- -->17</p></div><div class=\"mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 [&amp;&gt;div]:h-full [&amp;_a]:h-full [&amp;_figure]:h-full\"><div><a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Read Junior M.&#x27;s review on Booksy\" class=\"group block\"><figure class=\"hairline-strong bg-cream p-8 transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-bone group-hover:shadow-lg\"><p class=\"font-mono text-xs tracking-[0.3em] text-forest\">★★★★★</p><blockquote class=\"mt-5 text-[15px] leading-relaxed text-stone-700\">It would be a disservice for me not to say how talented this guy is. He has worked his way up through the ranks to not only becoming a business owner but a virtuoso in his line of work. Make no mistake; you will not find a more caring or real person like Tedi and you will not be disappointed in booking an appointment with him. I promise you that. The reviews here speaks for themselves. The gift he has and his attention to detail is unlike any other barber I&#x27;ve had in the past. It is the satisfactory feeling of having an impeccable and perfect cut I have after leaving his chair that keeps me coming back time and time again. I will not go to any other barber because I know I get a high quality cut every time.</blockquote><figcaption class=\"mono-micro mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-stone-500\"><span class=\"text-ink\">Junior M.</span><span aria-hidden=\"true\">·</span><span>Dec 27, 2024</span><span aria-hidden=\"true\">·</span><span class=\"text-forest\">via <!-- -->Booksy<!-- --> ↗</span></figcaption></figure></a></div><div><a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Read Pablo C.&#x27;s review on Booksy\" class=\"group block\"><figure class=\"hairline-strong bg-cream p-8 transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-bone group-hover:shadow-lg\"><p class=\"font-mono text-xs tracking-[0.3em] text-forest\">★★★★★</p><blockquote class=\"mt-5 text-[15px] leading-relaxed text-stone-700\">I had an awesome experience at this barbershop. The shop was clean, the vibe was friendly, and my barber really listened to what I wanted. He took his time with the fade, made sure the lineup was sharp, and checked in to make sure I was happy throughout. The cut came out even better than I expected. If you’re looking for a consistent, professional, and welcoming barbershop, this is spot on 5 stars.</blockquote><figcaption class=\"mono-micro mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-stone-500\"><span class=\"text-ink\">Pablo C.</span><span aria-hidden=\"true\">·</span><span>Oct 19, 2026</span><span aria-hidden=\"true\">·</span><span class=\"text-forest\">via <!-- -->Booksy<!-- --> ↗</span></figcaption></figure></a></div><div><a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Read Samy A.&#x27;s review on Booksy\" class=\"group block\"><figure class=\"hairline-strong bg-cream p-8 transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-bone group-hover:shadow-lg\"><p class=\"font-mono text-xs tracking-[0.3em] text-forest\">★★★★★</p><blockquote class=\"mt-5 text-[15px] leading-relaxed text-stone-700\">Tedi as usual hooked it up with the best cut I’ve had in a while. The atmosphere of the shop is elegant &amp; classy. He is one of the most hospitable barber’s i’ve got the pleasure of getting cut by. He deserves all the good business coming his way. Highly recommend him !!</blockquote><figcaption class=\"mono-micro mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-stone-500\"><span class=\"text-ink\">Samy A.</span><span aria-hidden=\"true\">·</span><span>Nov 25, 2024</span><span aria-hidden=\"true\">·</span><span class=\"text-forest\">via <!-- -->Booksy<!-- --> ↗</span></figcaption></figure></a></div><div><a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Read Curt C.&#x27;s review on Booksy\" class=\"group block\"><figure class=\"hairline-strong bg-cream p-8 transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-bone group-hover:shadow-lg\"><p class=\"font-mono text-xs tracking-[0.3em] text-forest\">★★★★★</p><blockquote class=\"mt-5 text-[15px] leading-relaxed text-stone-700\">One of the best cuts i got iN a while.  Not too pricy, Quick and GOOD..  DEFINITELY PASSING ALONG HIS SPOT TO MY FRIENDS.  Also very clean and professional environment..not gonna lie , the room makes me feel like a speciel client...</blockquote><figcaption class=\"mono-micro mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-stone-500\"><span class=\"text-ink\">Curt C.</span><span aria-hidden=\"true\">·</span><span>Jan 15, 2025</span><span aria-hidden=\"true\">·</span><span class=\"text-forest\">via <!-- -->Booksy<!-- --> ↗</span></figcaption></figure></a></div><div><a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Read Brittany M.&#x27;s review on Booksy\" class=\"group block\"><figure class=\"hairline-strong bg-cream p-8 transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-bone group-hover:shadow-lg\"><p class=\"font-mono text-xs tracking-[0.3em] text-forest\">★★★★★</p><blockquote class=\"mt-5 text-[15px] leading-relaxed text-stone-700\">Tedi did a great job with my son’s haircut! The space is clean and welcoming, and Tedi was so friendly and patient. Booking was super easy, and the whole experience was smooth from start to finish. Highly recommend!</blockquote><figcaption class=\"mono-micro mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-stone-500\"><span class=\"text-ink\">Brittany M.</span><span aria-hidden=\"true\">·</span><span>Oct 17, 2025</span><span aria-hidden=\"true\">·</span><span class=\"text-forest\">via <!-- -->Booksy<!-- --> ↗</span></figcaption></figure></a></div><div><a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Read Mark C.&#x27;s review on Booksy\" class=\"group block\"><figure class=\"hairline-strong bg-cream p-8 transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-bone group-hover:shadow-lg\"><p class=\"font-mono text-xs tracking-[0.3em] text-forest\">★★★★★</p><blockquote class=\"mt-5 text-[15px] leading-relaxed text-stone-700\">Best barber in this part of town Don’t waste your time looking for a barber Teddi is your guy from amazing haircuts to great service. Cuts all types of hair and always has you looking fresh walking out the door</blockquote><figcaption class=\"mono-micro mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-stone-500\"><span class=\"text-ink\">Mark C.</span><span aria-hidden=\"true\">·</span><span>Oct 12, 2026</span><span aria-hidden=\"true\">·</span><span class=\"text-forest\">via <!-- -->Booksy<!-- --> ↗</span></figcaption></figure></a></div><div><a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Read John L.&#x27;s review on Booksy\" class=\"group block\"><figure class=\"hairline-strong bg-cream p-8 transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-bone group-hover:shadow-lg\"><p class=\"font-mono text-xs tracking-[0.3em] text-forest\">★★★★★</p><blockquote class=\"mt-5 text-[15px] leading-relaxed text-stone-700\">Teddy has excellent skills and very professional.Very respectful always on time and pays attention to details!! He cuts me and my kids and theres no one else id trust to do that .Check him out asap!!!!</blockquote><figcaption class=\"mono-micro mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-stone-500\"><span class=\"text-ink\">John L.</span><span aria-hidden=\"true\">·</span><span>May 25, 2026</span><span aria-hidden=\"true\">·</span><span class=\"text-forest\">via <!-- -->Booksy<!-- --> ↗</span></figcaption></figure></a></div><div><a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Read Cody n.&#x27;s review on Booksy\" class=\"group block\"><figure class=\"hairline-strong bg-cream p-8 transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-bone group-hover:shadow-lg\"><p class=\"font-mono text-xs tracking-[0.3em] text-forest\">★★★★★</p><blockquote class=\"mt-5 text-[15px] leading-relaxed text-stone-700\">He’s been cutting my hairs for about 4 years now. His studio is a great environment to be at. Tedi is excellent not only at his craft but great with time management. 100% would recommend to anyone.</blockquote><figcaption class=\"mono-micro mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-stone-500\"><span class=\"text-ink\">Cody n.</span><span aria-hidden=\"true\">·</span><span>Jul 2, 2025</span><span aria-hidden=\"true\">·</span><span class=\"text-forest\">via <!-- -->Booksy<!-- --> ↗</span></figcaption></figure></a></div><div><a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Read Pat S.&#x27;s review on Booksy\" class=\"group block\"><figure class=\"hairline-strong bg-cream p-8 transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-bone group-hover:shadow-lg\"><p class=\"font-mono text-xs tracking-[0.3em] text-forest\">★★★★★</p><blockquote class=\"mt-5 text-[15px] leading-relaxed text-stone-700\">Matt is fantastic. Listens to customers suggestions. He is very professional. Matt can work with anyone the young and the not so young. You will be very pleased with the results.</blockquote><figcaption class=\"mono-micro mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-stone-500\"><span class=\"text-ink\">Pat S.</span><span aria-hidden=\"true\">·</span><span>Sep 10, 2026</span><span aria-hidden=\"true\">·</span><span class=\"text-forest\">via <!-- -->Booksy<!-- --> ↗</span></figcaption></figure></a></div><div><a href=\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Read Mark C.&#x27;s review on Booksy\" class=\"group block\"><figure class=\"hairline-strong bg-cream p-8 transition-all duration-300 group-hover:-translate-y-1 group-hover:bg-bone group-hover:shadow-lg\"><p class=\"font-mono text-xs tracking-[0.3em] text-forest\">★★★★★</p><blockquote class=\"mt-5 text-[15px] leading-relaxed text-stone-700\">Teddy is easily the most professional and most attentive Barber I&#x27;ve ever had and always does a perfect job going to him for over a year now and always getting a perfect haircut</blockquote><figcaption class=\"mono-micro mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-stone-500\"><span class=\"text-ink\">Mark C.</span><span aria-hidden=\"true\">·</span><span>Feb 22, 2025</span><span aria-hidden=\"true\">·</span><span class=\"text-forest\">via <!-- -->Booksy<!-- --> ↗</span></figcaption></figure></a></div></div></div><nav class=\"hairline-t mt-10 flex items-center justify-center gap-1 pt-8 sm:gap-2\" aria-label=\"Reviews pagination\"><button type=\"button\" disabled=\"\" aria-label=\"Previous page\" class=\"flex size-9 shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-600 transition-colors hover:border-forest hover:text-forest disabled:cursor-not-allowed disabled:opacity-30 sm:size-11\">←</button><button type=\"button\" aria-current=\"page\" aria-label=\"Page 1\" class=\"size-9 shrink-0 rounded-[4px] border font-mono text-xs transition-colors sm:size-11 border-forest bg-forest text-bone\">1</button><button type=\"button\" aria-label=\"Page 2