property=\"og:url\" content=\"https://tedishairstudio.com\"/><meta property=\"og:site_name\" content=\"Tedi&#x27;s Hair Studio\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:image\" content=\"https://tedishairstudio.com/professional-images/backgroundmaybe.jpeg\"/><meta property=\"og:image:width\" content=\"2160\"/><meta property=\"og:image:height\" content=\"1440\"/><meta property=\"og:image:alt\" content=\"Inside Tedi&#x27;s Hair Studio, Matawan NJ\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Tedi&#x27;s Hair Studio | Private Barber Studio in Matawan, NJ\"/><meta name=\"twitter:description\" content=\"Private, by-appointment hair studio in Matawan, NJ. One chair, one barber, cuts done with intention. Inside Bellazio Collective.\"/><meta name=\"twitter:image\" content=\"https://tedishairstudio.com/professional-images/backgroundmaybe.jpeg\"/><link rel=\"icon\" href=\"/icon.png?d0129c038a491353\" type=\"image/png\" sizes=\"1163x1163\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:bg-bone focus:p-4 focus:text-forest\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"HairSalon\",\"@id\":\"https://tedishairstudio.com/#studio\",\"name\":\"Tedi's Hair Studio\",\"description\":\"Private, by-appointment hair studio in Matawan, NJ. One chair, one barber, cuts done with intention. Inside Bellazio Collective.\",\"url\":\"https://tedishairstudio.com\",\"telephone\":\"+17329477359\",\"image\":\"https://tedishairstudio.com/professional-images/chair-wash.jpg\",\"priceRange\":\"$$\",\"sameAs\":[\"https://instagram.com/tedishairstudio\",\"https://booksy.com/en-us/1231797_tedis-hair-studio_