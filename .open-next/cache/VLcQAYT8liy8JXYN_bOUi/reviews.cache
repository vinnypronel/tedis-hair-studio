llelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L7\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\nd:[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"pb-24 lg:pb-36\",\"children\":[\"$\",\"div\",null,{\"className\":\"px-6 pt-24 md:px-12 lg:px-20 lg:pt-28\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1440px]\",\"children\":[[\"$\",\"$L12\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"hairline-b grid gap-x-16 gap-y-12 pb-12 lg:grid-cols-12 lg:items-center lg:pb-14\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:col-span-5\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"display-lg\",\"children\":[\"$\",\"em\",null,{\"className\":\"italic\",\"children\":\"Five stars, only.\"}]}],[\"$\",\"div\",null,{\"className\":\"mt-8 flex items-end gap-6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-display text-7xl leading-[0.85] tracking-tight\",\"children\":\"5.0\"}],[\"$\",\"span\",null,{\"className\":\"pb-1 font-mono text-lg tracking-[0.3em] text-[#d4af37]\",\"children\":\"★★★★★\"}]]}],[\"$\",\"p\",null,{\"className\":\"mono-micro mt-5 text-stone-500\",\"children\":[\"Based on \",168,\" reviews ·\",\" \",[\"$\",\"a\",null,{\"href\":\"https://booksy.com/en-us/1231797_tedis-hair-studio_barber-shop_28674_matawan#business-reviews\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"link-draw text-stone-700\",\"children\":[\"via \",\"Booksy\",\" ↗\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mono-micro mt-5 text-stone-500\",\"children\":[\"Last updated 10/27/26\",[\"$\",\"span\",null,{\"aria-hidden\":true,\"className\":\"caret-blink ml-1 inline-block h-[1em] w-[2px] translate-y-[2px] bg-stone-500 align-middle\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"lg:col-span-7\",\"children\":[[\"$\",\"$L13\",null,{\"distribution\":{\"1\":0,\"2\":0,\"3\":0,\"4\":0,\"5\":168},\"total\":168}],[\"$\",\"div\",null,{\"className\":\"mt-6 flex items-center justify-between gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mono-micro text-stone-500\",\"children\":[168,\" of \",168,\" are five stars. Nothing below.\"]}],[\"$\",\"span\",null,{\"className\":\"font-mono text-base tracking-[0.25em] text-forest\",\"aria-label\":\"5 stars\",\"children\":\"★★★★★\"}]]}]]}]]}]}],[\"$\",\"$L14\",null,{\"reviews\":[{\"id\":\"rev-8228861\",\"authorName\":\"Junior M.\",\"rating\":5,\"text\":\"It would be a disservice for me not to say how talented this guy is. He has worked his way up through the ranks to not only becoming a business owner but a virtuoso in his line of work. Make no mistake; you will not find a more caring or real person like Tedi and you will not be disappointed in booking an appointment with him. I promise you that. The reviews here speaks for themselves. The gift he has and his attention to detail is unlike any other barber I've had in the past. It is the satisfactory feeling of having an impeccable and perfect cut I have after leaving his chair that keeps me coming back time and time again. I will not go to any other barber because I know I get a high quality cut every time.\",\"source\":\"booksy\",\"sourceDate\":\"2024-12-27\",\"featured\":false,\"published\":true,\"sortOrder\":142},{\"id\":\"rev-11814919\",\"authorName\":\"Pablo C.\",\"rating\":5,\"text\":\"I had an awesome experience at this barbershop. The shop was clean, the vibe was friendly, and my barber really listened to what I wanted. He took his time with the fade, made sure the lineup was sharp, and checked in to make sure I was happy throughout. The cut came out even better than I expected. If you’re looking for a consistent, professional, and welcoming barbershop, this is spot on 5 stars.\",\"source\":\"booksy\",\"sourceDate\":\"2026-10-19\",\"featured\":false,\"published\":true,\"sortOrder\":6},{\"id\":\"rev-8111290\",\"authorName\":\"Samy A.\",\"rating\":5,\"text\":\"Tedi as usual hooked it up with the best cut I’ve had in a while. The atmosphere of the shop is elegant & classy. He is one of the most hospitable barber’s i’ve got the pleasure of getting cut by. He deserves all the good business coming his way. Highly recommend him !!\",\"source\":\"booksy\",\"sourceDate\":\"2024-11-25\",\"featured\":false,\"published\":true,\"sortOrder\":152},{\"id\":\"rev-8292973\",\"authorName\":\"Curt C.\",\"rating\":5,\"text\":\"One of the best cuts i got iN a while.  Not too pricy, Quick and GOOD..  DEFINITELY PASSING ALONG HIS SPOT TO MY FRIENDS.  Also very clean and professional environment..not gonna lie , the room makes me feel like a speciel client...\",\"source\":\"booksy\",\"sourceDate\":\"2025-01-15\",\"featured\":false,\"published\":true,\"sortOrder\":137},{\"id\":\"rev-9622816\",\"authorName\":\"Brittany M.\",\"rating\":5,\"text\":\"Tedi did a great job with my son’s haircut! The space is clean and welcoming, and Tedi was so friendly and patient. Booking was super easy, and the whole experience was smooth from start to finish. Highly recommend!\",\"source\":\"booksy\",\"sourceDate\":\"2025-10-17\",\"featured\":false,\"published\":true,\"sortOrder\":73},{\"id\":\"rev-11688045\",\"authorName\":\"Mark C.\",\"rating\":5,\"text\":\"Best barber in this part of town Don’t waste your time looking for a barber Teddi is your guy from amazing haircuts to great service. Cuts all types of hair and always has you looking fresh walking out the door\",\"source\":\"booksy\",\"sourceDate\":\"2026-10-12\",\"featured\":false,\"published\":true,\"sortOrder\":13},{\"id\":\"rev-10711913\",\"authorName\":\"John L.\",\"rating\":5,\"text\":\"Teddy has excellent skills and very professional.Very respectful always on time and pays attention to details!! He cuts me and my kids and theres no one else id trust to do that .Check him out asap!!!!\",\"source\":\"booksy\",\"sourceDate\":\"2026-05-25\",\"featured\":false,\"published\":true,\"sortOrder\":47},{\"id\":\"rev-9023607\",\"authorName\":\"Cody n.\",\"rating\":5,\"text\":\"He’s been cutting my hairs for about 4 years now. His studio is a great environment to be at. Tedi is excellent not only at his craft but great with time management. 100% would recommend to anyone.\",\"source\":\"booksy\",\"sourceDate\":\"2025-07-02\",\"featured\":false,\"published\":true,\"sortOrder\":103},{\"id\":\"rev-11479030\",\"authorName\":\"Pat S.\",\"rating\":5,\"text\":\"Matt is fantastic. Listens to customers suggestions. He is very professional. Matt can work with anyone the young and the not so young. You will be very pleased with the results.\",\"source\":\"booksy\",\"sourceDate\":\"2026-09-10\",\"featured\":false,\"published\":true,\"sortOrder\":21},{\"id\":\"rev-8446237\",\"authorName\":\"Mark C.\",\"rating\":5,\"text\":\"Teddy is easily the most professional and most attentive Barber I've ever had and always does a perfect job going to him for over a year now and always getting a perfect haircut\",\"source\":\"booksy\",\"sourceDate\":\"2025-02-22\",\"featured\":false,\"published\":true,\"sortOrder\":131},{\"id\":\"rev-8003900\",\"authorName\":\"Mark C.\",\"rating\":5,\"text\":\"Teddi is a amazing Barber I’ve been going to him for the past year and I take my son with me never disappoints people always ask where I get my haircut from nice shop also\",\"source\":\"booksy\",\"sourceDate\":\"2024-10-26\",\"featured\":false,\"published\":true,\"sortOrder\":158},{\"id\":\"rev-9623131\",\"authorName\":\"Mark C.\",\"rating\":5,\"text\":\"Tedi is the best barber around he is the most professional amazing with kids all around great Barber. Great person any style he can do if I could give 10 stars I would.\",\"source\":\"booksy\",\"sourceDate\":\"2025-10-17\",\"featured\":false,\"published\":true,\"sortOrder\":71},{\"id\":\"rev-8956521\",\"authorName\":\"Danny D.\",\"rating\":5,\"text\":\"I had an amazing experience and couldn’t be more than happy with my haircut. Very polite and takes his time to make sure you’re happy. I am definitely coming back.\",\"source\":\"booksy\",\"sourceDate\":\"2025-06-19\",\"featured\":false,\"published\":true,\"sortOrder\":111},{\"id\":\"rev-8991739\",\"authorName\":\"christian m.\",\"rating\":5,\"text\":\"Tedi has been my go to for years now, seriously crisp work and attention to detail always have you looking fresh, best barber I’ve had and the best one around.\",\"source\":\"booksy\",\"sourceDate\":\"2025-06-26\",\"featured\":false,\"published\":true,\"sortOrder\":104},{\"id\":\"rev-11063092\",\"authorName\":\"Jacob R.\",\"rating\":5,\"text\":\"He did exactly what my son asked him to do. The shop is clean and inviting. He ran on time. We continue to return for haircuts for my very picky teenage son.\",\"source\":\"booksy\",\"sourceDate\":\"2026-07-24\",\"featured\":true,\"published\":true,\"sortOrder\":37},{\"id\":\"rev-8280179\",\"authorName\":\"Rachael M.\",\"rating\":5,\"text\":\"Polite courtesy service . Right on time . Clean shop . Great atmosphere. Clean smooth cut . We’ve been customers for about 4 yrs now . Highly recommended.\",\"source\":\"booksy\",\"sourceDate\":\"2025-01-11\",\"featured\":false,\"published\":true,\"sortOrder\":140},{\"id\":\"rev-8989737\",\"authorName\":\"Benjamin R.\",\"rating\":5,\"text\":\"Tedi’s the best barber around. Always on time, friendly, and has super nice spot! Would recommend to anyone looking for a new barber or need a quick cut!\",\"source\":\"booksy\",\"sourceDate\":\"2025-06-26\",\"featured\":false,\"published\":true,\"sortOrder\":105},{\"id\":\"rev-8951421\",\"authorName\":\"Neel D.\",\"rating\":5,\"text\":\"Been here twice so far and Matt has given me the best haircut I’ve ever gotten! The only place I’m going to for my haircuts from now on!!\",\"source\":\"booksy\",\"sourceDate\":\"2025-06-18\",\"featured\":false,\"published\":true,\"sortOrder\":113},{\"id\":\"rev-9099911\",\"authorName\":\"Pat S.\",\"rating\":5,\"text\":\"Matt is always accommodating. He will go out of his way for his customers. \\nNeed a fresh cut. Make an appointment at Tedi's Hair Studio\",\"source\":\"booksy\",\"sourceDate\":\"2025-07-18\",\"featured\":false,\"published\":true,\"sortOrder\":95},{\"id\":\"rev-9024469\",\"authorName\":\"Liam H.\",\"rating\":5,\"text\":\"Been going to Tedi for years and he always gives me a great cut.  His studio is very clean and you can tell he takes pride in his work.\",\"source\":\"booksy\",\"sourceDate\":\"2025-07-02\",\"featured\":false,\"published\":true,\"sortOrder\":101},{\"id\":\"rev-8529274\",\"authorName\":\"Shaun R.\",\"rating\":5,\"text\":\"Matt does an awesome job cutting mine and my son’s hair.  Always on time, professional, and reasonably priced.  Highly recommend!\",\"source\":\"booksy\",\"sourceDate\":\"2025-03-14\",\"featured\":false,\"published\":true,\"sortOrder\":128},{\"id\":\"rev-11394250\",\"authorName\":\"Rachael M.\",\"rating\":5,\"text\":\"Did an amazing job ! Courteous, friendly ,Great atmosphere . Took the time to listen to  what we wanted . He didn’t disappoint!\",\"source\":\"booksy\",\"sourceDate\":\"2026-08-31\",\"featured\":false,\"published\":true,\"sortOrder\":23},{\"id\":\"rev-8223195\",\"authorName\":\"Mike V.\",\"rating\":5,\"text\":\"Best in the state of NJ. Incredibly talented and overall great customer service. Highly recommend for anyone who gets a fade.\",\"source\":\"booksy\",\"sourceDate\":\"2024-12-26\",\"featured\":false,\"published\":true,\"sortOrder\":143},{\"id\":\"rev-8014390\",\"authorName\":\"Pat S.\",\"rating\":5,\"text\":\"Matt is a true professional. Friendly, courteous, he listens to your needs. \\nI would reccomend Tedi's Hair Studio to all.\",\"source\":\"booksy\",\"sourceDate\":\"2024-10-29\",\"featured\":false,\"published\":true,\"sortOrder\":157},{\"id\":\"rev-9791294\",\"authorName\":\"Matthew G.\",\"rating\":5,\"text\":\"Nothing but excellence. He does exactly what you want, sharing photos of the style you’re going for goes a long way.\",\"source\":\"booksy\",\"sourceDate\":\"2025-11-22\",\"featured\":true,\"published\":true,\"sortOrder\":66},{\"id\":\"rev-9831469\",\"authorName\":\"Colin T.\",\"rating\":5,\"text\":\"Tedi gives some of the cleanest haircuts I’ve seen and he’s very personable to talk to throughout your appointment.\",\"source\":\"booksy\",\"sourceDate\":\"2025-12-02\",\"featured\":false,\"published\":true,\"sortOrder\":65},{\"id\":\"rev-10142040\",\"authorName\":\"Sebastian A. P.\",\"rating\":5,\"text\":\"ON TIME, CLEAN SPOT! DUDE REALLY TAKES HIS PRIDE & PASSION INTO HIS WORK! DON’T HESITATE JUST BOOK STRAIGHT 10/10\",\"source\":\"booksy\",\"sourceDate\":\"2026-02-05\",\"featured\":false,\"published\":true,\"sortOrder\":58},{\"id\":\"rev-9284742\",\"authorName\":\"Myke A.\",\"rating\":5,\"text\":\"Moved from NY to NJ and all i have to say Matt hands up got me right. I highly recommend Tedi’s! See you soon! 🧸\",\"source\":\"booksy\",\"sourceDate\":\"2025-08-19\",\"featured\":false,\"published\":true,\"sortOrder\":87},{\"id\":\"rev-8042453\",\"authorName\":\"Ceejay L.\",\"rating\":5,\"text\":\"Phenomenal experience. Every time I go to Tedi, I know my haircut will come out fantastic. Highly recommend him!\",\"source\":\"booksy\",\"sourceDate\":\"2024-11-06\",\"featured\":false,\"published\":true,\"sortOrder\":155},{\"id\":\"rev-11058330\",\"authorName\":\"Arti H.\",\"rating\":5,\"text\":\"Tedi is the greatest barber ever I’ve never met another better he just be cookin and he’s valid in the hood.\",\"source\":\"booksy\",\"sourceDate\":\"2026-07-23\",\"featured\":false,\"published\":true,\"sortOrder\":38},{\"id\":\"rev-10581958\",\"authorName\":\"Jonathan C.\",\"rating\":5,\"text\":\"Great studio ! 1st time going to him and I’m always going to go back to Matt. Great guy , great cut !\",\"source\":\"booksy\",\"sourceDate\":\"2026-04-30\",\"featured\":false,\"published\":true,\"sortOrder\":49},{\"id\":\"rev-7978950\",\"authorName\":\"Marko A.\",\"rating\":5,\"text\":\"Great haircut, kept it classic and simple. Nice clean shop in a cool new location.  Thank you, Tedi.\",\"source\":\"booksy\",\"sourceDate\":\"2024-10-19\",\"featured\":false,\"published\":true,\"sortOrder\":163},{\"id\":\"rev-10677866\",\"authorName\":\"Antonio B.\",\"rating\":5,\"text\":\"Tedi never disappoints. Great cuts and conversations. If you need a cut, he's the guy to go to 100%\",\"source\":\"booksy\",\"sourceDate\":\"2026-05-18\",\"featured\":false,\"published\":true,\"sortOrder\":48},{\"id\":\"rev-11354893\",\"authorName\":\"Fabio C.\",\"rating\":5,\"text\":\"Teddy is the BEST barber always does the best work and fast never disappoints. Highly recommend\",\"source\":\"booksy\",\"sourceDate\":\"2026-08-28\",\"featured\":false,\"published\":true,\"sortOrder\":28},{\"id\":\"rev-8534388\",\"authorName\":\"John S.\",\"rating\":5,\"text\":\"Great Adult and kids cuts. Good private atmosphere. Appointment times are always on the money.\",\"source\":\"booksy\",\"sourceDate\":\"2025-03-15\",\"featured\":false,\"published\":true,\"sortOrder\":126},{\"id\":\"rev-8194730\",\"authorName\":\"Nathan R.\",\"rating\":5,\"text\":\"Easily the best barber in the area. Does exactly what you tell him too. Perfection guaranteed.\",\"source\":\"booksy\",\"sourceDate\":\"2024-12-18\",\"featured\":false,\"published\":true,\"sortOrder\":146},{\"id\":\"rev-11753248\",\"authorName\":\"Justin H.\",\"rating\":5,\"text\":\"Great cut, great convos, gets me right everytime always walk out with my confidence restored.\",\"source\":\"booksy\",\"sourceDate\":\"2026-10-16\",\"featured\":false,\"published\":true,\"sortOrder\":9},{\"id\":\"rev-11288049\",\"authorName\":\"James P.\",\"rating\":5,\"text\":\"Perfect haircut every single time, you are not rushed and he pays attention to every detail\",\"source\":\"booksy\",\"sourceDate\":\"2026-08-23\",\"featured\":true,\"published\":true,\"sortOrder\":30},{\"id\":\"rev-9590064\",\"authorName\":\"Zach P.\",\"rating\":5,\"text\":\"Welcoming atmosphere! Tedi is hands down the Best barber in NJ! Check out Tedi Hair Studios\",\"source\":\"booksy\",\"sourceDate\":\"2025-10-13\",\"featured\":false,\"published\":true,\"sortOrder\":74},{\"id\":\"rev-10156820\",\"authorName\":\"Tyler M.\",\"rating\":5,\"text\":\"Best place to get a cut always leave feeling better than you walked in Matt’s the best\",\"source\":\"booksy\",\"sourceDate\":\"2026-02-07\",\"featured\":false,\"published\":true,\"sortOrder\":57},{\"id\":\"rev-9184775\",\"authorName\":\"Julie B.\",\"rating\":5,\"text\":\"did a great job on both if my boys. First time using him will definitely be back again\",\"source\":\"booksy\",\"sourceDate\":\"2025-08-04\",\"featured\":false,\"published\":true,\"sortOrder\":92},{\"id\":\"rev-9756106\",\"authorName\":\"Fabio C.\",\"rating\":5,\"text\":\"Tedi’s super chill and always gets my cut looking clean. Definitely my go-to barber.\",\"source\":\"booksy\",\"sourceDate\":\"2025-11-15\",\"featured\":false,\"published\":true,\"sortOrder\":68},{\"id\":\"rev-8661345\",\"authorName\":\"RICHARD D.\",\"rating\":5,\"text\":\"You always do excellent. I see excellent in you you ex zoom excellence glory to God.\",\"source\":\"booksy\",\"sourceDate\":\"2025-04-14\",\"featured\":false,\"published\":true,\"sortOrder\":124},{\"id\":\"rev-8049901\",\"authorName\":\"Oleg B.\",\"rating\":5,\"text\":\"The best barber in the area! Tedi does a great job with any cuts, highly recommend!!\",\"source\":\"booksy\",\"sourceDate\":\"2024-11-08\",\"featured\":false,\"published\":true,\"sortOrder\":154},{\"id\":\"rev-9516394\",\"authorName\":\"\",\"rating\":5,\"text\":\"Super clean cuts and takes his time which I appreciate bc this is art 💯💯💯\",\"source\":\"booksy\",\"sourceDate\":\"2025-09-30\",\"featured\":false,\"published\":true,\"sortOrder\":76},{\"id\":\"rev-11943784\",\"authorName\":\"Rachael M.\",\"rating\":5,\"text\":\"Great job ! Perfect exactly what we wanted . All around excellent service !\